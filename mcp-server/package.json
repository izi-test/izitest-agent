    "ai": "^6.0.156",
    "better-sqlite3": "^11.7.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  }
}
